# MongoDB connection string (required)
# Example (local): mongodb://127.0.0.1:27017
# Example (Atlas): mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=""

# Database name (optional; backend defaults to "a3")
MONGODB_DB="a3"

# Server port (optional; backend defaults to 4000)
PORT=4000